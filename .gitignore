# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw field data (GPS traces reveal home location; interview notes stay private)
/data/private/
*.gpslog.json

# Claude Code worktrees
/.claude/worktrees/

# 見本の設定（キーは入っていない）は公開する
!.env.example

# デモ動画の録画（大きいので共有しない）
/demo/recordings/
/demo/.pw/

# 国交省の新宿駅屋内地図（元の Shapefile。変換したものだけを data/indoor に置く）
/data/raw/mlit-*/
/data/raw/hokonavi-*/
/data/raw/hokonavi-oedo-nw/
